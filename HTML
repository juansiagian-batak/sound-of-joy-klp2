    <!-- Bagian 3: Catalog Section - Nofadillah Salsabillah (1710625102) PM 2 -->
    <section id="catalog-section" data-role="PM">
      <div class="section-header">
        <span class="section-eyebrow">KATALOG RESMI SOUND OF JOY</span>
        <h2 class="section-heading">Pilih Kategori Tiket Festival &amp; Seminar</h2>
        <p class="section-description">
          Seluruh kategori tiket sudah mencakup pajak acara. Gunakan kode promosi 
          <strong class="inline-code">JOYBISDIG</strong> pada kalkulator di bawah untuk menikmati potongan harga 10%.
        </p>
      </div>

      <div class="catalog-container">
        <article class="ticket-card card-early">
          <div class="ticket-card-top">
            <span class="ticket-tier-badge">KUOTA MAHASISWA • HEMAT</span>
            <h3 class="ticket-title">Tiket Masuk Lebih Awal</h3>
            <p class="ticket-subtitle">Early Bird Entry Pass (Check-in sebelum 14.00 WIB)</p>
          </div>

          <div class="ticket-price-box">
            <span class="currency">Rp</span>
            <span class="amount">120.000</span>
            <span class="unit">/ peserta</span>
          </div>

          <div class="ticket-card-body">
            <p class="ticket-summary">
              Pilihan paling terjangkau bagi mahasiswa yang hadir sejak sesi seminar siang dimulai hingga panggung musik sore hari.
            </p>
            <ul class="ticket-facilities">
              <li>Akses penuh sesi Seminar Nasional Kampus di Auditorium Utama.</li>
              <li>Akses area Festival Musik Reguler (wajib masuk gerbang sebelum pukul 14.00 WIB).</li>
              <li>E-Sertifikat Seminar Nasional bernilai poin kredit kemahasiswaan (SKPI).</li>
              <li>Gelang tiket tenun (woven wristband) edisi Sound of Joy.</li>
            </ul>
          </div>

          <div class="ticket-card-footer">
            <div class="promo-tag-box">
              <span>Kode Promo Berlaku:</span>
              <strong>JOYBISDIG (Diskon 10%)</strong>
            </div>
            <a href="#calc-section" class="btn-select-package" onclick="pilihPaketDariKatalog('120000')">Hitung Paket Ini</a>
          </div>
        </article>

        <article class="ticket-card card-regular is-featured">
          <div class="featured-ribbon">PALING BANYAK DIPILIH</div>
          <div class="ticket-card-top">
            <span class="ticket-tier-badge">AKSES PENUH • BEBAS JAM MASUK</span>
            <h3 class="ticket-title">Tiket Reguler Festival</h3>
            <p class="ticket-subtitle">All-Day Seminar &amp; Main Stage Festival Pass</p>
          </div>

          <div class="ticket-price-box">
            <span class="currency">Rp</span>
            <span class="amount">185.000</span>
            <span class="unit">/ peserta</span>
          </div>

          <div class="ticket-card-body">
            <p class="ticket-summary">
              Paket standar terlengkap dengan jam kedatangan fleksibel untuk menikmati seluruh rangkaian acara dari pagi hingga penutupan konser malam.
            </p>
            <ul class="ticket-facilities">
              <li>Bebas jam masuk (flexible gate entry) ke sesi Seminar maupun Panggung Musik Malam.</li>
              <li>Akses zona Standing Festival tepat di depan panggung utama Sound of Joy.</li>
              <li>E-Sertifikat Seminar Nasional + Materi Digital Pembicara (Speaker Deck).</li>
              <li>Paket suvenir berisi tote bag kanvas, stiker pack, dan kupon minuman segar.</li>
            </ul>
          </div>

          <div class="ticket-card-footer">
            <div class="promo-tag-box">
              <span>Kode Promo Berlaku:</span>
              <strong>JOYBISDIG (Diskon 10%)</strong>
            </div>
            <a href="#calc-section" class="btn-select-package" onclick="pilihPaketDariKatalog('185000')">Hitung Paket Ini</a>
          </div>
        </article>

        <article class="ticket-card card-vip">
          <div class="ticket-card-top">
            <span class="ticket-tier-badge">PRIORITAS VIP • KUOTA EKSKLUSIF</span>
            <h3 class="ticket-title">Tiket Tamu Kehormatan</h3>
            <p class="ticket-subtitle">VIP Front-Row, Fast Track &amp; Exclusive Merch Pass</p>
          </div>

          <div class="ticket-price-box">
            <span class="currency">Rp</span>
            <span class="amount">325.000</span>
            <span class="unit">/ peserta</span>
