    <!-- Bagian 4: Calculator Section - Ibnu Faris Pribadi (1710625118) SE 1 & Umar (1710625202) SE 2 -->
    <section id="calc-section" data-role="SE">
      <div class="calc-wrapper">
        <div class="calc-info-panel">
          <span class="section-eyebrow">SIMULASI BIAYA REAL-TIME</span>
          <h2 class="calc-heading">Kalkulator Harga Tiket Sound of Joy</h2>
          <p class="calc-lead">
            Hitung estimasi pembayaran tiket Anda sebelum melakukan pemesanan. Sistem akan otomatis 
            mengalikan harga kategori tiket dengan jumlah pembelian serta memeriksa syarat potongan diskon.
          </p>

          <div class="promo-rules-card">
            <h3>Ketentuan Diskon Otomatis (10%):</h3>
            <ul>
              <li>
                <strong>Syarat 1 (Kode Promo):</strong> Ketikkan kode <span class="code-badge">JOYBISDIG</span> pada kolom kode promosi.
              </li>
              <li>
                <strong>Syarat 2 (Kolektif Kampus):</strong> Pembelian minimal <strong>3 tiket</strong> atau lebih otomatis mendapatkan diskon 10% meskipun tanpa kode promo.
              </li>
            </ul>
          </div>
        </div>

        <div class="calc-box">
          <form id="ticket-calc-form" onsubmit="return false;">
            <div class="form-field">
              <label for="kategori-tiket">1. Pilih Kategori Tiket:</label>
              <select id="kategori-tiket" name="kategori-tiket" required>
                <option value="120000" data-nama="Tiket Masuk Lebih Awal">
                  Tiket Masuk Lebih Awal — Rp120.000 / tiket
                </option>
                <option value="185000" data-nama="Tiket Reguler Festival" selected>
                  Tiket Reguler Festival — Rp185.000 / tiket
                </option>
                <option value="325000" data-nama="Tiket Tamu Kehormatan">
                  Tiket Tamu Kehormatan — Rp325.000 / tiket
                </option>
              </select>
            </div>

            <div class="form-field">
              <label for="jumlah-tiket">2. Jumlah Tiket yang Dibeli:</label>
              <input 
                type="number" 
                id="jumlah-tiket" 
                name="jumlah-tiket" 
                min="1" 
                max="50" 
                value="1" 
                placeholder="Masukkan jumlah tiket (contoh: 3)"
                required
              >
              <small class="field-hint">Tip: Beli minimal 3 tiket untuk diskon grup otomatis 10%.</small>
            </div>

            <div class="form-field">
              <label for="kode-promo">3. Kode Promosi:</label>
              <input 
                type="text" 
                id="kode-promo" 
                name="kode-promo" 
                placeholder="Ketik kode promo: JOYBISDIG"
                autocomplete="off"
              >
            </div>

            <button type="button" id="btn-hitung" onclick="hitungTotalTiket()">
              Hitung Simulasi Pembayaran
            </button>
          </form>

          <div id="hasil-kalkulator" class="calc-output" aria-live="polite">
            <div class="output-empty">
              <p>Pilih kategori tiket, masukkan jumlah pembelian, lalu tekan tombol <strong>Hitung Simulasi Pembayaran</strong> untuk melihat rincian harga awal, potongan diskon, dan total akhir.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
